<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The smallest plist iOS will accept: a name, an identifier, a version, and the one
  device family. No launch storyboard and no icons, because there is no UI to launch
  yet - see ./README.md.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>JRock</string>
    <key>CFBundleExecutable</key>
    <string>JRock</string>
    <key>CFBundleIdentifier</key>
    <string>com.nosuchblogger.jrock</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.3.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>MinimumOSVersion</key>
    <string>13.0</string>
    <!-- 1 is iPhone. iPad would be 2, and there is no reason to claim it yet. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
    </array>
</dict>
</plist>
