# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# JRock runtime data (prompt, conversation log, per-message files, temp files).
# JRock/ was the name up to 5.2.0, and is still ignored: a working copy that has not
# been started with 5.3.0 yet still has one.
__JRock/
JRock/

# Maven output for the tests in tests/ (also holds the __JRock/ folder a test run
# creates, since surefire runs the app with its working directory in here)
target/

# Gradle output for the experimental mobile targets in android/ and ios/ (build/
# also holds the copy of JRock.java their copyJRockSource task makes). Scoped to
# those two trees on purpose: a bare "build/" matches at any depth, and would
# also swallow .github/build/, which is source and is tracked.
android/**/build/
ios/**/build/
.gradle/
local.properties

# Classes from the CI step that compiles samples/agents/ and samples/flows/ against
# the jar
out-automation/

# Classes from the CI step that compiles the installer, and the copy of it the build
# puts beside the jar for the release artifact: the root keeps one Java file, and
# InstallJRock.java lives in installer/.
out-installer/
/InstallJRock.java

# Pictures from .github/build/Screenshots.java. They are a build output, uploaded as an
# artifact by the screenshots workflow; the ones this README shows are in images/, which
# is tracked.
screenshots/

# Checksums BuildJar writes beside the jar (the jar itself is covered by *.jar)
jrock.jar.sha256
jrock.jar.md5

# The browser profile the web agent keeps beside its working folder: cookies, and
# whatever the operator signed in to in that window. Never ours to commit.
jrock-browser-profile/

# The README as a DOCX, written by .github/build/ReadmeDocx.java. A build output like
# the jar: the README itself is the source, and CI uploads the document as an artifact.
README.docx
